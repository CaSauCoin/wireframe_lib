(footprint "SW-Slide-SPDT-3Pin-THT_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "SS12D00 / SS12F15 Subminiature Slide Switch SPDT On-On, 3-pin THT pitch 2.54mm (1: A, 2: Common, 3: B)")
  (attr through_hole)
  (fp_rect (start -4.250 -2.000) (end 4.250 2.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -4.250 -2.000) (end 4.250 2.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -4.750 -2.500) (end 4.750 2.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -2.540 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.540 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/SW-Slide-SPDT-3Pin-THT.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
