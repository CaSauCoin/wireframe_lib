(footprint "Audio-Jack-3.5mm-PJ320A-THT_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "PJ-320A 3.5mm Stereo Headphone Audio Jack Socket, 5-pin THT (1: Sleeve/GND, 2: Tip/Left, 3: Ring/Right, 4: Tip Switch, 5: Ring Switch)")
  (attr through_hole)
  (fp_rect (start -7.000 -3.000) (end 7.000 3.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -7.000 -3.000) (end 7.000 3.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -7.500 -3.500) (end 7.500 3.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -5.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -2.500 3.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.500 3.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -2.500 -3.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 2.500 -3.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Audio-Jack-3.5mm-PJ320A-THT.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
