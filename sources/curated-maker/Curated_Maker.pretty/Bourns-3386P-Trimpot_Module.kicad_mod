(footprint "Bourns-3386P-Trimpot_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Bourns 3386P 3/8inch Square Single-Turn Cermet Trimpot, top adjust, triangular layout (1: CCW, 2: Wiper, 3: CW), 9.53 x 9.53 mm")
  (attr through_hole)
  (fp_rect (start -4.765 -4.765) (end 4.765 4.765) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -4.765 -4.765) (end 4.765 4.765) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -5.265 -5.265) (end 5.265 5.265) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -2.540 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.540 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Bourns-3386P-Trimpot.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
