(footprint "Pixhawk-4_Mechanical" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Mechanical/system integration footprint; body 84 x 44 mm")
  (attr through_hole)
  (fp_rect (start -42.000 -22.000) (end 42.000 22.000)
    (stroke (width 0.3) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -42.000 -22.000) (end 42.000 22.000)
    (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (pad "" np_thru_hole circle (at -30 -16) (size 2.3 2.3) (drill 2.3) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 30 -16) (size 2.3 2.3) (drill 2.3) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -30 16) (size 2.3 2.3) (drill 2.3) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 30 16) (size 2.3 2.3) (drill 2.3) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Pixhawk-4.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
