(footprint "Bourns-3314G-SMD-Trimpot_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Bourns 3314G 4mm Square SMD Trimming Potentiometer, single turn, gull-wing leads (1: CCW, 2: Wiper, 3: CW), 4.5 x 4.5 mm")
  (attr through_hole)
  (fp_rect (start -2.250 -2.250) (end 2.250 2.250) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -2.250 -2.250) (end 2.250 2.250) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -2.750 -2.750) (end 2.750 2.750) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -1.300 -2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 1.300 -2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
