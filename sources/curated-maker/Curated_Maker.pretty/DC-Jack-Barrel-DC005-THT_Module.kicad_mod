(footprint "DC-Jack-Barrel-DC005-THT_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "DC-005 5.5mm x 2.1mm DC Power Barrel Jack, 3-pin THT (1: Center Pin Pos, 2: Shunt Switch, 3: Sleeve Ground)")
  (attr through_hole)
  (fp_rect (start -7.000 -4.500) (end 7.000 4.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -7.000 -4.500) (end 7.000 4.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -7.500 -5.000) (end 7.500 5.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at 0.000 3.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 4.700 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 0.000 -3.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/DC-Jack-Barrel-DC005-THT.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
