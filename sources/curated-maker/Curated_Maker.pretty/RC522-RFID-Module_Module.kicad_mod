  (pad "6" thru_hole circle (at 3.810 27.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 6.350 27.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 8.890 27.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
