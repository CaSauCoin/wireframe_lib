  (fp_rect (start -20.500 -30.500) (end 20.500 30.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -17.000 -27.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 17.000 -27.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
