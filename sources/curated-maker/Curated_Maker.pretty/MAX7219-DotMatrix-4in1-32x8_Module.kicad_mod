(footprint "MAX7219-DotMatrix-4in1-32x8_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "32x8 Red LED dot matrix display module (4 cascaded 8x8 blocks, 4x MAX7219 drivers), SPI input & daisy-chain output, 128.0 x 32.0 mm")
  (attr through_hole)
  (fp_rect (start -64.000 -16.000) (end 64.000 16.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -64.000 -16.000) (end 64.000 16.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -64.500 -16.500) (end 64.500 16.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -61.000 -12.500) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 61.000 -12.500) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -61.000 12.500) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 61.000 12.500) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -61.000 -5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -61.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -61.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -61.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at -61.000 5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 61.000 -5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 61.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 61.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "9" thru_hole circle (at 61.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "10" thru_hole circle (at 61.000 5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/MAX7219-DotMatrix-4in1-32x8.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
