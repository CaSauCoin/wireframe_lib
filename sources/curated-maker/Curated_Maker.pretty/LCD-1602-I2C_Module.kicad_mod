(footprint "LCD-1602-I2C_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "16x2 Character LCD display module with PCF8574 I2C backpack interface 4-pin header, HD44780 standard, 80.0 x 36.0 mm")
  (attr through_hole)
  (fp_rect (start -40.000 -18.000) (end 40.000 18.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -40.000 -18.000) (end 40.000 18.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -40.500 -18.500) (end 40.500 18.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -37.500 -15.500) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 37.500 -15.500) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -37.500 15.500) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 37.500 15.500) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -36.000 -15.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -36.000 -12.460) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -36.000 -9.920) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -36.000 -7.380) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/LCD-1602-I2C.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
