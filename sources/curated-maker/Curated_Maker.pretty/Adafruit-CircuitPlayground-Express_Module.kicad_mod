  (pad "10" thru_hole circle (at -17.591 14.029) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "11" thru_hole circle (at -21.936 5.007) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "12" thru_hole circle (at -21.936 -5.007) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "13" thru_hole circle (at -17.591 -14.029) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "14" thru_hole circle (at -9.762 -20.272) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Adafruit-CircuitPlayground-Express.wrl"
