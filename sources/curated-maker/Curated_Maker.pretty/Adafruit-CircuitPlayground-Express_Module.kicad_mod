  (attr through_hole)
  (fp_circle (center 0 0) (end 25.400 0) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_circle (center 0 0) (end 25.400 0) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 25.900 0) (stroke (width 0.05) (type default)) (fill (type none)) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at 0.000 -22.500) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 9.762 -20.272) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 17.591 -14.029) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
