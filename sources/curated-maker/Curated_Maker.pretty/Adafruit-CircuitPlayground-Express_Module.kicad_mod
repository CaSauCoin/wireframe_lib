  (pad "7" thru_hole circle (at 9.762 20.272) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 0.000 22.500) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
