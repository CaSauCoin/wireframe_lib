(footprint "Bourns-3362P-Trimpot_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Bourns 3362P 1/4inch Square Single-Turn Cermet Trimpot, top adjust, triangular layout 2.54mm pitch (1: CCW, 2: Wiper, 3: CW), 6.6 x 7.0 mm")
  (attr through_hole)
  (fp_rect (start -3.300 -3.500) (end 3.300 3.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -3.300 -3.500) (end 3.300 3.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -3.800 -4.000) (end 3.800 4.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -2.540 1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 -1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.540 1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Bourns-3362P-Trimpot.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
