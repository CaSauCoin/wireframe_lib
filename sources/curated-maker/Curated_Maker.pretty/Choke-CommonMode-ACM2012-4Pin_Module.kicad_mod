(footprint "Choke-CommonMode-ACM2012-4Pin_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "TDK ACM2012 / 0805 SMD Common Mode Choke Filter for USB 2.0 / CAN Bus EMI suppression, 4-pin")
  (attr through_hole)
  (fp_rect (start -1.000 -0.600) (end 1.000 0.600) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -1.000 -0.600) (end 1.000 0.600) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -1.500 -1.100) (end 1.500 1.100) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -0.800 -0.400) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.800 -0.400) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 0.800 0.400) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -0.800 0.400) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Choke-CommonMode-ACM2012-4Pin.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
