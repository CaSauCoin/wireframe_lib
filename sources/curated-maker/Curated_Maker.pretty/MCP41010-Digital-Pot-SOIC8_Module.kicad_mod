(footprint "MCP41010-Digital-Pot-SOIC8_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Microchip MCP41010 1-Channel 10k Digital Potentiometer with SPI Interface, SOIC-8 package, 4.9 x 3.9 mm")
  (attr through_hole)
  (fp_rect (start -2.450 -1.950) (end 2.450 1.950) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -2.450 -1.950) (end 2.450 1.950) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -2.950 -2.450) (end 2.950 2.450) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -1.905 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -1.905 -0.850) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -1.905 0.850) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -1.905 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 1.905 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 1.905 0.850) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 1.905 -0.850) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 1.905 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/MCP41010-Digital-Pot-SOIC8.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
