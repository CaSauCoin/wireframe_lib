(footprint "AMASS-XT60PW-F_PCB" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Mechanical/system integration footprint; body 17.2 x 17.2 mm")
  (attr through_hole)
  (fp_rect (start -8.600 -8.600) (end 8.600 8.600)
    (stroke (width 0.3) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -8.600 -8.600) (end 8.600 8.600)
    (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (pad "1" thru_hole circle (at -3.6 0) (size 4.5 4.5) (drill 2.7) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 3.6 0) (size 4.5 4.5) (drill 2.7) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/AMASS-XT60PW-F.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
