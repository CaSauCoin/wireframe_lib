(footprint "HM-10-BLE-Module_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "HM-10 Bluetooth Low Energy (BLE 4.0) CC2541 serial transceiver module on breakout board, 6-pin 2.54mm header, 40.0 x 16.0 mm")
  (attr through_hole)
  (fp_rect (start -8.000 -20.000) (end 8.000 20.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -8.000 -20.000) (end 8.000 20.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -8.500 -20.500) (end 8.500 20.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at 0.000 -16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.540 -16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 5.080 -16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 7.620 -16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 10.160 -16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 12.700 -16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/HM-10-BLE-Module.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
