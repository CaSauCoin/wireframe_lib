(footprint "WS2812B-RGB-Matrix-16x16_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "16x16 Addressable RGB LED matrix panel, 256 WS2812B / NeoPixel LEDs, DIN/DOUT and power injection pads, 160.0 x 160.0 mm")
  (attr through_hole)
  (fp_rect (start -80.000 -80.000) (end 80.000 80.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -80.000 -80.000) (end 80.000 80.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -80.500 -80.500) (end 80.500 80.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -75.000 -75.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 75.000 -75.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -75.000 75.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 75.000 75.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -75.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -75.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -75.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 75.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 75.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 75.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at -2.540 75.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 2.540 75.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/WS2812B-RGB-Matrix-16x16.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
