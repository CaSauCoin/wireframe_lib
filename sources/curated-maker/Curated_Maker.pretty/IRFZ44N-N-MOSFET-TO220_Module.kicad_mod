(footprint "IRFZ44N-N-MOSFET-TO220_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Infineon IRFZ44N 55V 49A 17.5mΩ N-Channel Power MOSFET, TO-220 (1: Gate, 2: Drain, 3: Source, Tab: Drain)")
  (attr through_hole)
  (fp_rect (start -5.000 -2.250) (end 5.000 2.250) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -5.000 -2.250) (end 5.000 2.250) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -5.500 -2.750) (end 5.500 2.750) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -2.540 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.540 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/IRFZ44N-N-MOSFET-TO220.wrl"
