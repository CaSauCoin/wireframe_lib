(footprint "TM1637-4Digit-Display_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "0.36 inch 4-digit 7-segment LED display module with clock colon, TM1637 driver, 4-pin header (GND, VCC, DIO, CLK), 42.0 x 24.0 mm")
  (attr through_hole)
  (fp_rect (start -21.000 -12.000) (end 21.000 12.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -21.000 -12.000) (end 21.000 12.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -21.500 -12.500) (end 21.500 12.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -18.000 -9.000) (size 2.200 2.200) (drill 2.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 18.000 -9.000) (size 2.200 2.200) (drill 2.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -18.000 9.000) (size 2.200 2.200) (drill 2.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 18.000 9.000) (size 2.200 2.200) (drill 2.200) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -3.810 9.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -1.270 9.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 1.270 9.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 3.810 9.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/TM1637-4Digit-Display.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
