(footprint "TM1638-8Digit-Display-Key-Module_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "TM1638 8-digit 7-segment display module with 8 push buttons and 8 bi-color LEDs, 5-pin serial interface, 76.2 x 50.8 mm")
  (attr through_hole)
  (fp_rect (start -38.100 -25.400) (end 38.100 25.400) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -38.100 -25.400) (end 38.100 25.400) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -38.600 -25.900) (end 38.600 25.900) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -35.000 -22.000) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 35.000 -22.000) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -35.000 22.000) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 35.000 22.000) (size 3.200 3.200) (drill 3.200) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at 34.000 -5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 34.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 34.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 34.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 34.000 5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/TM1638-8Digit-Display-Key-Module.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
