(footprint "Bourns-TC33X-SMD-Trimpot_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Bourns TC33X 3mm SMD Cermet Trimming Potentiometer, ultra-compact (1: CCW, 2: Wiper, 3: CW), 3.8 x 3.0 mm")
  (attr through_hole)
  (fp_rect (start -1.900 -1.500) (end 1.900 1.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -1.900 -1.500) (end 1.900 1.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -2.400 -2.000) (end 2.400 2.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -1.000 -1.200) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 1.200) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 1.000 -1.200) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Bourns-TC33X-SMD-Trimpot.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
