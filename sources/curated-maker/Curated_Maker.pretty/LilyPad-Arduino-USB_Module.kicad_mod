(footprint "LilyPad-Arduino-USB_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "SparkFun LilyPad Arduino USB, ATmega32U4 with native micro-USB, circular wearable sewable board, diameter 50.0 mm")
  (attr through_hole)
  (fp_circle (center 0 0) (end 25.000 0) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_circle (center 0 0) (end 25.000 0) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 25.500 0) (stroke (width 0.05) (type default)) (fill (type none)) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at 0.000 -22.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 11.000 -19.053) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 19.053 -11.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 22.000 0.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 19.053 11.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 11.000 19.053) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 0.000 22.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at -11.000 19.053) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "9" thru_hole circle (at -19.053 11.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "10" thru_hole circle (at -22.000 0.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "11" thru_hole circle (at -19.053 -11.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "12" thru_hole circle (at -11.000 -19.053) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/LilyPad-Arduino-USB.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
