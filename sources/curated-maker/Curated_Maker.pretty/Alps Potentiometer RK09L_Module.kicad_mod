(footprint "Alps Potentiometer RK09L_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Alps Alpine RK09L 9mm Rotary Metal Shaft Potentiometer, 3-pin THT pitch 2.5mm with 2 snap-in mounting tabs (1: CCW, 2: Wiper, 3: CW), 9.8 x 11.0 mm")
  (attr through_hole)
  (fp_rect (start -4.900 -5.500) (end 4.900 5.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -4.900 -5.500) (end 4.900 5.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -5.400 -6.000) (end 5.400 6.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -4.500 7.000) (size 1.500 1.500) (drill 1.500) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 4.500 7.000) (size 1.500 1.500) (drill 1.500) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -2.500 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.500 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Potentiometer-Alps-RK09L.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
