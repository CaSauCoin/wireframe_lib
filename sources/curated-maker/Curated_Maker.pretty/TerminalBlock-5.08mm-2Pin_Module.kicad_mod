(footprint "TerminalBlock-5.08mm-2Pin_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "KF301 / Phoenix Contact MKDS 5.08mm Pitch 2-Pin Screw Terminal Block Connector")
  (attr through_hole)
  (fp_rect (start -5.080 -3.800) (end 5.080 3.800) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -5.080 -3.800) (end 5.080 3.800) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -5.580 -4.300) (end 5.580 4.300) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -2.540 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.540 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/TerminalBlock-5.08mm-2Pin.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
