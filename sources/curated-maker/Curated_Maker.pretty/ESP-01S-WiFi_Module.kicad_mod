(footprint "ESP-01S-WiFi_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Ai-Thinker ESP-01S ESP8266 WiFi SoC module with 1MB Flash, PCB antenna, 2x4 2.54mm header, 24.8 x 14.4 mm")
  (attr through_hole)
  (fp_rect (start -12.400 -7.200) (end 12.400 7.200) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -12.400 -7.200) (end 12.400 7.200) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -12.900 -7.700) (end 12.900 7.700) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -9.270 -3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -9.270 -1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -9.270 1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -9.270 3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at -6.730 -3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at -6.730 -1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at -6.730 1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at -6.730 3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/ESP-01S-WiFi.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
