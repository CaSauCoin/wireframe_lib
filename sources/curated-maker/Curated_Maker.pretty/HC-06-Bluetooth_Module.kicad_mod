(footprint "HC-06-Bluetooth_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "HC-06 Classic Bluetooth 2.0+EDR SPP serial slave module on breakout board, 4-pin 2.54mm header, 37.3 x 15.5 mm")
  (attr through_hole)
  (fp_rect (start -7.750 -18.650) (end 7.750 18.650) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -7.750 -18.650) (end 7.750 18.650) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -8.250 -19.150) (end 8.250 19.150) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at 0.000 -15.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.540 -15.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 5.080 -15.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 7.620 -15.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/HC-06-Bluetooth.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
