(footprint "WS2812B-RGB-Matrix-8x8_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "8x8 Addressable RGB LED matrix panel, 64 WS2812B / NeoPixel LEDs, cascaded DIN/DOUT 3-pin headers, 65.0 x 65.0 mm")
  (attr through_hole)
  (fp_rect (start -32.500 -32.500) (end 32.500 32.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -32.500 -32.500) (end 32.500 32.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -33.000 -33.000) (end 33.000 33.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -28.000 -28.000) (size 2.500 2.500) (drill 2.500) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 28.000 -28.000) (size 2.500 2.500) (drill 2.500) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -28.000 28.000) (size 2.500 2.500) (drill 2.500) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 28.000 28.000) (size 2.500 2.500) (drill 2.500) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -27.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -27.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -27.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 27.000 -2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 27.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 27.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/WS2812B-RGB-Matrix-8x8.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
