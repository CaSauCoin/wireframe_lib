(footprint "Rotary-Encoder-EC11-Switch_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Alps / Bourns EC11 11mm Incremental Rotary Encoder with Push Switch, 5 electrical pins + 2 mounting brackets")
  (attr through_hole)
  (fp_rect (start -5.850 -6.750) (end 5.850 6.750) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -5.850 -6.750) (end 5.850 6.750) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -6.350 -7.250) (end 6.350 7.250) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -5.850 0.000) (size 2.200 2.200) (drill 2.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 5.850 0.000) (size 2.200 2.200) (drill 2.200) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -2.500 -7.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 -7.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.500 -7.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -2.500 7.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 2.500 7.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Rotary-Encoder-EC11-Switch.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
