(footprint "MAX7219-DotMatrix-8x8_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "8x8 red LED dot matrix display module with MAX7219 driver, cascadable SPI 5-pin header, 32.0 x 32.0 mm")
  (attr through_hole)
  (fp_rect (start -16.000 -16.000) (end 16.000 16.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -16.000 -16.000) (end 16.000 16.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -16.500 -16.500) (end 16.500 16.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -5.080 13.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -2.540 13.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 0.000 13.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 2.540 13.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 5.080 13.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/MAX7219-DotMatrix-8x8.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
