(footprint "Potentiometer-RV09-Vertical_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "RV09 Vertical 9mm Rotary Potentiometer with bracket, 3-pin THT pitch 2.5mm (1: CCW, 2: Wiper, 3: CW), 9.5 x 11.5 mm")
  (attr through_hole)
  (fp_rect (start -4.750 -5.750) (end 4.750 5.750) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -4.750 -5.750) (end 4.750 5.750) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -5.250 -6.250) (end 5.250 6.250) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -4.000 6.500) (size 1.200 1.200) (drill 1.200) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 4.000 6.500) (size 1.200 1.200) (drill 1.200) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -2.500 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.500 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Potentiometer-RV09-Vertical.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
