  (attr through_hole)
  (fp_circle (center 0 0) (end 22.500 0) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_circle (center 0 0) (end 22.500 0) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 23.000 0) (stroke (width 0.05) (type default)) (fill (type none)) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at 0.000 -20.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 8.678 -18.019) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 15.637 -12.470) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
