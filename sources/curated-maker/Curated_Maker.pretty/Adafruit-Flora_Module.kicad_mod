  (pad "7" thru_hole circle (at 8.678 18.019) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 0.000 20.000) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
