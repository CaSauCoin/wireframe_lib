  (pad "10" thru_hole circle (at -15.637 12.470) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "11" thru_hole circle (at -19.499 4.450) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "12" thru_hole circle (at -19.499 -4.450) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "13" thru_hole circle (at -15.637 -12.470) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (pad "14" thru_hole circle (at -8.678 -18.019) (size 3.500 3.500) (drill 1.800) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Adafruit-Flora.wrl"
