(footprint "SW-Tactile-6x6mm-4Pin-THT_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Omron B3F-1000 / Standard 6x6mm Momentary Tactile Push Button, 4-pin THT (Pads 1-2 bridged, Pads 3-4 bridged)")
  (attr through_hole)
  (fp_rect (start -3.000 -3.000) (end 3.000 3.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -3.000 -3.000) (end 3.000 3.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -3.500 -3.500) (end 3.500 3.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -3.250 -2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 3.250 -2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -3.250 2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 3.250 2.250) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/SW-Tactile-6x6mm-4Pin-THT.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
