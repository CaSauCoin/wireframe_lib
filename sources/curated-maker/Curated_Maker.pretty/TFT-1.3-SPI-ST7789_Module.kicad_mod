(footprint "TFT-1.3-SPI-ST7789_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "1.3 inch IPS full-color TFT display module, 240x240 pixels, ST7789 driver, 7-pin SPI header, 39.0 x 28.0 mm")
  (attr through_hole)
  (fp_rect (start -14.000 -19.500) (end 14.000 19.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -14.000 -19.500) (end 14.000 19.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -14.500 -20.000) (end 14.500 20.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -7.620 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -5.080 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -2.540 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 0.000 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 2.540 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 5.080 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 7.620 16.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/TFT-1.3-SPI-ST7789.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
