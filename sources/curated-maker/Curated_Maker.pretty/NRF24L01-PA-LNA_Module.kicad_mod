(footprint "NRF24L01-PA-LNA_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Long-range nRF24L01+ 2.4GHz RF transceiver module with RFX2401C PA/LNA and external SMA antenna, 2x4 2.54mm header, 41.0 x 15.5 mm")
  (attr through_hole)
  (fp_rect (start -20.500 -7.750) (end 20.500 7.750) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -20.500 -7.750) (end 20.500 7.750) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -21.000 -8.250) (end 21.000 8.250) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -11.270 -3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -11.270 -1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -11.270 1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -11.270 3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at -8.730 -3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at -8.730 -1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at -8.730 1.270) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at -8.730 3.810) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/NRF24L01-PA-LNA.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
