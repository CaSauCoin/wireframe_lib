(footprint "MAX7219-8Digit-Display_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "8-digit 7-segment LED display module with MAX7219 driver, SPI serial interface 5-pin header, 82.0 x 15.0 mm")
  (attr through_hole)
  (fp_rect (start -41.000 -7.500) (end 41.000 7.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -41.000 -7.500) (end 41.000 7.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -41.500 -8.000) (end 41.500 8.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -38.000 -5.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 38.000 -5.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -38.000 5.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 38.000 5.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -38.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -38.000 2.540) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -38.000 5.080) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -38.000 7.620) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at -38.000 10.160) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/MAX7219-8Digit-Display.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
