(footprint "Potentiometer-WH148-Dual-16mm_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "WH148 Dual-Unit Stereo 16mm Rotary Potentiometer, 6-pin dual row THT pitch 5.0mm x 5.0mm (Ch A: 1A, 2A, 3A; Ch B: 1B, 2B, 3B), 17.0 x 25.0 mm")
  (attr through_hole)
  (fp_rect (start -8.500 -12.500) (end 8.500 12.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -8.500 -12.500) (end 8.500 12.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -9.000 -13.000) (end 9.000 13.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1A" thru_hole rect (at -5.000 -2.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2A" thru_hole circle (at 0.000 -2.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3A" thru_hole circle (at 5.000 -2.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "1B" thru_hole circle (at -5.000 2.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2B" thru_hole circle (at 0.000 2.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3B" thru_hole circle (at 5.000 2.500) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Potentiometer-WH148-Dual-16mm.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
