(footprint "NEO-6M-GPS-Module_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "u-blox NEO-6M GPS satellite receiver module with onboard ceramic patch antenna and EEPROM, 5-pin 2.54mm header, 36.0 x 26.0 mm")
  (attr through_hole)
  (fp_rect (start -13.000 -18.000) (end 13.000 18.000) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -13.000 -18.000) (end 13.000 18.000) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -13.500 -18.500) (end 13.500 18.500) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "" np_thru_hole circle (at -10.000 -15.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 10.000 -15.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -10.000 15.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 10.000 15.000) (size 3.000 3.000) (drill 3.000) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at -5.080 11.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -2.540 11.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 0.000 11.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 2.540 11.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 5.080 11.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/NEO-6M-GPS-Module.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
