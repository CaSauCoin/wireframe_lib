(footprint "Oscillator-Active-3225-4Pin_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "3225 Active SPXO Clock Oscillator 4-Pin SMD (1: Output Enable/Tri-state, 2: GND, 3: Clock OUT, 4: VDD)")
  (attr through_hole)
  (fp_rect (start -1.600 -1.250) (end 1.600 1.250) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -1.600 -1.250) (end 1.600 1.250) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -2.100 -1.750) (end 2.100 1.750) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -1.100 -0.800) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 1.100 -0.800) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 1.100 0.800) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -1.100 0.800) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Oscillator-Active-3225-4Pin.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
