(footprint "Crystal-HC49S-THT-2Pin_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "HC-49S Low Profile Quartz Crystal Resonator 2-Pin THT (16MHz/8MHz/12MHz)")
  (attr through_hole)
  (fp_rect (start -5.500 -2.325) (end 5.500 2.325) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -5.500 -2.325) (end 5.500 2.325) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -6.000 -2.825) (end 6.000 2.825) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -2.440 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.440 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Crystal-HC49S-THT-2Pin.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
