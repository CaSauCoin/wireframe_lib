(footprint "Potentiometer-WH148-16mm_Module" (version 20240108) (generator wireframe_libforge)
  (layer "F.Cu")
  (descr "Alpha / Song Huei WH148 16mm Rotary Potentiometer Single-Unit Mono, 3-pin THT pitch 5.0mm (1: CCW, 2: Wiper, 3: CW), 17.0 x 17.0 mm")
  (attr through_hole)
  (fp_rect (start -8.500 -8.500) (end 8.500 8.500) (stroke (width 0.15) (type default)) (fill (type none)) (layer "F.Fab"))
  (fp_rect (start -8.500 -8.500) (end 8.500 8.500) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -9.000 -9.000) (end 9.000 9.000) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -5.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 5.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (model "${KICAD8_3DMODEL_DIR}/Curated_Maker.3dshapes/Potentiometer-WH148-16mm.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
