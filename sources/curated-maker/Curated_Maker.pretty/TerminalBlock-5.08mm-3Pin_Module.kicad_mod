  (fp_rect (start -7.620 -3.800) (end 7.620 3.800) (stroke (width 0.2) (type default)) (fill (type none)) (layer "F.SilkS"))
  (fp_rect (start -8.120 -4.300) (end 8.120 4.300) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at -5.080 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.000 0.000) (size 1.700 1.700) (drill 1.000) (layers "*.Cu" "*.Mask"))
